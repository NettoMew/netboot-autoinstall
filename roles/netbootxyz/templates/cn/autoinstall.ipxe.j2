#
# Debian and Ubuntu unattended install
#
# Asks for a network interface, an address, an optional root password and a
# mirror, then boots straight from that mirror: the Debian installer for
# Debian, Alpine Linux for Ubuntu, which it copies from the cloud image.
# The preseed, the install scripts and the CUDA repository key travel
# inside this bootloader and reach the installer as cpio archives, so
# nothing has to be hosted anywhere.
#

:cn_autoinstall
iseq ${buildarch} arm64 && goto cn_arm64 ||
cpuid --ext 29 || goto cn_exit
set cn_arch amd64
set cn_alpine_arch x86_64
goto cn_menu

:cn_arm64
set cn_arch arm64
set cn_alpine_arch aarch64

:cn_menu
isset ${cn_os_item} || set cn_os_item cn_debian
menu ${site_name} - unattended install
item --gap Install
item cn_debian Debian 13
item cn_ubuntu2404 Ubuntu 24.04
item cn_ubuntu2604 Ubuntu 26.04
item --gap Other
item cn_exit ${site_name} menu
item cn_shell iPXE shell
item cn_reboot Reboot
choose --default ${cn_os_item} cn_os_item || goto cn_exit
goto ${cn_os_item}

:cn_debian
set cn_os debian
set cn_name Debian 13
goto cn_nic

:cn_ubuntu2404
set cn_os ubuntu
set cn_release 24.04
set cn_codename noble
set cn_name Ubuntu 24.04
goto cn_nic

:cn_ubuntu2604
set cn_os ubuntu
set cn_release 26.04
set cn_codename resolute
set cn_name Ubuntu 26.04
goto cn_nic

:cn_nic
# All interfaces come up together and get a few seconds to negotiate, then
# each one is checked for a link, so the cable in use shows in the list.
set cn_index:int32 0
:cn_nic_open
isset ${net${cn_index}/mac} || goto cn_nic_wait
ifopen net${cn_index} ||
inc cn_index
goto cn_nic_open
:cn_nic_wait
sleep 3
clear cn_nic_linked
set cn_index:int32 0
menu Network interface
:cn_nic_item
isset ${net${cn_index}/mac} || goto cn_nic_choose
iflinkwait --timeout 100 net${cn_index} && goto cn_nic_up ||
item net${cn_index} net${cn_index} ${net${cn_index}/mac} ${net${cn_index}/chip}
goto cn_nic_next
:cn_nic_up
item net${cn_index} net${cn_index} ${net${cn_index}/mac} ${net${cn_index}/chip} link up
isset ${cn_nic_linked} || set cn_nic_linked net${cn_index}
:cn_nic_next
inc cn_index
goto cn_nic_item
:cn_nic_choose
isset ${cn_nic} || set cn_nic ${cn_nic_linked}
isset ${cn_nic} || set cn_nic net0
choose --default ${cn_nic} cn_nic || goto cn_menu

:cn_address
isset ${cn_dns} || set cn_dns:ipv4 {{ cn_autoinstall_dns }}
form Network on ${cn_nic} ${${cn_nic}/mac}
item cn_ip:ipv4 IP address, leave empty for DHCP
item cn_netmask:ipv4 Netmask
item cn_gateway:ipv4 Gateway
item cn_dns:ipv4 DNS server
present || goto cn_nic
ifclose ||
isset ${cn_ip} || goto cn_dhcp
isset ${cn_netmask} || goto cn_address
isset ${cn_gateway} || goto cn_address

:cn_static
set ${cn_nic}/ip ${cn_ip}
set ${cn_nic}/netmask ${cn_netmask}
set ${cn_nic}/gateway ${cn_gateway}
set dns ${cn_dns}
ifopen ${cn_nic} || goto cn_offline
set cn_address_text ${cn_ip} netmask ${cn_netmask} gateway ${cn_gateway}
goto cn_system

:cn_dhcp
clear ${cn_nic}/ip
clear ${cn_nic}/netmask
clear ${cn_nic}/gateway
ifconf --configurator dhcp ${cn_nic} || goto cn_offline
set cn_address_text DHCP, currently ${${cn_nic}/ip}
goto cn_system

:cn_offline
echo ${cn_nic} could not be brought up, press any key to edit the address
prompt
goto cn_address

:cn_system
# The hostname follows the system chosen until it is edited.
iseq x${cn_hostname} x${cn_hostname_default} && clear cn_hostname ||
set cn_hostname_default ${cn_os}
isset ${cn_hostname} || set cn_hostname ${cn_hostname_default}
isset ${cn_disk} || set cn_disk auto
form ${cn_name}
item cn_hostname Hostname
item --secret cn_password Root password, leave empty for SSH keys only
item cn_disk Target disk, auto or a device such as /dev/sda
present || goto cn_address

:cn_mirror
isset ${cn_mirror} || set cn_mirror {{ cn_autoinstall_mirrors[0].host }}
menu Mirror
{% for mirror in cn_autoinstall_mirrors %}
item {{ mirror.host }} {{ mirror.host }} - {{ mirror.name }}
{% endfor %}
item cn_mirror_other Other mirror...
choose --default ${cn_mirror} cn_mirror || goto cn_system
iseq ${cn_mirror} cn_mirror_other || goto cn_gpu
clear cn_mirror
echo -n Mirror host: ${} && read cn_mirror ||
isset ${cn_mirror} || goto cn_mirror

:cn_gpu
iseq ${cn_os} debian || goto cn_confirm
set cn_gpus:int32 0
clear cn_pci
:cn_gpu_scan
pciscan cn_pci || goto cn_confirm
iseq ${pci/${cn_pci}.0.2} 10de || goto cn_gpu_scan
iseq ${pci/${cn_pci}.11.1} 03 && inc cn_gpus ||
goto cn_gpu_scan

:cn_confirm
isset ${cn_nvidia} || set cn_nvidia auto
isset ${cn_password} && set cn_login SSH keys or password || set cn_login SSH keys only
menu Install ${cn_name}, the target disk will be erased
item --gap Disk: ${cn_disk}
item --gap Interface: ${cn_nic} ${${cn_nic}/mac}
item --gap Address: ${cn_address_text}
item --gap Mirror: ${cn_mirror}
item --gap Root login: ${cn_login}
iseq ${cn_os} debian && item --gap NVIDIA GPUs: ${cn_gpus} ||
item --gap
item cn_boot Install now
iseq ${cn_os} debian && item cn_nvidia_toggle NVIDIA driver: ${cn_nvidia} ||
item cn_menu Start over
choose --default cn_boot cn_choice || goto cn_mirror
goto ${cn_choice}

:cn_nvidia_toggle
iseq ${cn_nvidia} auto && set cn_nvidia off || set cn_nvidia auto
goto cn_confirm

:cn_boot
isset ${cn_password} && set cn_secret cn_password=${cn_password:hexraw} || clear cn_secret
goto cn_boot_${cn_os}

:cn_boot_debian
isset ${cn_ip} && set cn_netcfg netcfg/disable_autoconfig=true netcfg/get_ipaddress=${cn_ip} netcfg/get_netmask=${cn_netmask} netcfg/get_gateway=${cn_gateway} netcfg/get_nameservers=${cn_dns} netcfg/confirm_static=true || clear cn_netcfg
set cn_base http://${cn_mirror}/debian/dists/trixie/main/installer-${cn_arch}/current/images/netboot/debian-installer/${cn_arch}
echo Loading the Debian installer from ${cn_mirror}...
kernel --name cn_kernel ${cn_base}/linux auto=true priority=critical BOOTIF=01-${${cn_nic}/mac:hexhyp} netcfg/choose_interface=${${cn_nic}/mac} ${cn_netcfg} netcfg/hostname=${cn_hostname} mirror/http/hostname=${cn_mirror} apt-setup/security_host=${cn_mirror} cn_disk=${cn_disk} cn_nvidia=${cn_nvidia} ${cn_secret} {{ kernel_params }} || goto cn_error
initrd --name cn_initrd ${cn_base}/initrd.gz || goto cn_error
goto cn_start

:cn_boot_ubuntu
isset ${cn_ip} && set cn_alpine_ip ${cn_ip}::${cn_gateway}:${cn_netmask}::::${cn_dns} || set cn_alpine_ip dhcp
isset ${cn_ip} && set cn_static cn_ip=${cn_ip} cn_netmask=${cn_netmask} cn_gateway=${cn_gateway} cn_dns=${cn_dns} || clear cn_static
set cn_base http://${cn_mirror}/alpine/latest-stable/releases/${cn_alpine_arch}/netboot
echo Loading Alpine Linux from ${cn_mirror} to install ${cn_name}...
kernel --name cn_kernel ${cn_base}/vmlinuz-lts rdinit=/alpine-init.sh ip=${cn_alpine_ip} BOOTIF=01-${${cn_nic}/mac:hexhyp} alpine_repo=http://${cn_mirror}/alpine/latest-stable/main modloop=${cn_base}/modloop-lts apkovl=/ubuntu.apkovl.tar.gz ${cn_static} cn_release=${cn_release} cn_codename=${cn_codename} cn_mirror=${cn_mirror} cn_hostname=${cn_hostname} cn_disk=${cn_disk} ${cn_secret} {{ kernel_params }} || goto cn_error
initrd --name cn_initrd ${cn_base}/initramfs-lts || goto cn_error

:cn_start
# The embedded files are registered already. Naming them places them in
# the initramfs as files, every one of them, since an unnamed image would
# land there as raw bytes.
imgargs preseed.cfg preseed.cfg || goto cn_error
imgargs post.sh post.sh mode=755 || goto cn_error
imgargs cuda-archive-keyring.gpg cuda-archive-keyring.gpg || goto cn_error
imgargs ubuntu.apkovl.tar.gz ubuntu.apkovl.tar.gz || goto cn_error
imgargs alpine-init.sh alpine-init.sh mode=755 || goto cn_error
boot || goto cn_error

:cn_error
imgfree cn_kernel ||
imgfree cn_initrd ||
echo The installer could not be started, press any key to return
prompt
goto cn_confirm

:cn_shell
echo Type "exit" to return to the installer menu
shell
goto cn_menu

:cn_reboot
reboot
goto cn_menu

:cn_exit
imgfree preseed.cfg post.sh cuda-archive-keyring.gpg ubuntu.apkovl.tar.gz alpine-init.sh ||
set cn_released 1
goto start
