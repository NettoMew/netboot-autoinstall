#_preseed_V1
#
# Debian 13 unattended install, embedded in the {{ site_name }} bootloader.
#
# The bootloader passes the network, mirror, disk, password and NVIDIA
# choices on the kernel command line. Everything that does not depend on them lives here,
# and /post.sh carries the few steps that need a shell.
#

d-i preseed/early_command string sh /post.sh early

# Localization
d-i debian-installer/locale string en_US.UTF-8
d-i keyboard-configuration/xkb-keymap select us

# Mirror
d-i mirror/country string manual
d-i mirror/http/directory string /debian
d-i mirror/http/proxy string
d-i mirror/suite string trixie

# Accounts: root starts locked, post.sh adds the SSH keys and any password
d-i passwd/root-login boolean true
d-i passwd/make-user boolean false
d-i passwd/root-password-crypted password *

# Clock
d-i clock-setup/utc boolean true
d-i time/zone string {{ cn_autoinstall_timezone }}
d-i clock-setup/ntp boolean true
d-i clock-setup/ntp-server string {{ cn_autoinstall_ntp }}

# Partitioning: GPT, an EFI or BIOS boot partition, XFS on everything else
d-i partman/early_command string sh /post.sh partman
d-i partman-auto/method string regular
d-i partman-lvm/device_remove_lvm boolean true
d-i partman-md/device_remove_md boolean true
d-i partman-partitioning/choose_label select gpt
d-i partman-partitioning/default_label string gpt
d-i partman-partitioning/confirm_write_new_label boolean true
d-i partman-efi/non_efi_system boolean true
d-i partman-basicfilesystems/no_swap boolean false
d-i partman/choose_partition select finish
d-i partman/confirm boolean true
d-i partman/confirm_nooverwrite boolean true
d-i partman-auto/expert_recipe_efi string efi :: \
    512 1 512 free $iflabel{ gpt } method{ efi } format{ } . \
    1 1 -1 xfs method{ format } format{ } use_filesystem{ } filesystem{ xfs } mountpoint{ / } .
d-i partman-auto/expert_recipe_bios string bios :: \
    1 1 1 free $iflabel{ gpt } method{ biosgrub } . \
    1 1 -1 xfs method{ format } format{ } use_filesystem{ } filesystem{ xfs } mountpoint{ / } .

# Packages
d-i apt-setup/non-free-firmware boolean true
d-i apt-setup/enable-source-repositories boolean false
d-i apt-setup/security_path string /debian-security
tasksel tasksel/first multiselect ssh-server
d-i pkgsel/include string {{ cn_autoinstall_packages | join(' ') }}
d-i pkgsel/upgrade select full-upgrade
popularity-contest popularity-contest/participate boolean false

# Boot loader
d-i grub-installer/only_debian boolean true
d-i grub-installer/with_other_os boolean false
d-i grub-installer/force-efi-extra-removable boolean true

# Finish
d-i preseed/late_command string sh /post.sh late
d-i finish-install/reboot_in_progress note
